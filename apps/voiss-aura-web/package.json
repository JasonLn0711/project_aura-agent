{
  "name": "@voiss/aura-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "COPILOTKIT_TELEMETRY_DISABLED=true VOISS_MODE=local next dev --hostname 127.0.0.1 --port 3000",
    "demo": "COPILOTKIT_TELEMETRY_DISABLED=true VOISS_MODE=demo next dev --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test && playwright test --config playwright.local.config.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "build": "COPILOTKIT_TELEMETRY_DISABLED=true next build"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@copilotkit/react-core": "1.63.2",
    "@copilotkit/react-ui": "1.63.2",
    "@copilotkit/runtime": "1.63.2",
    "@copilotkit/sqlite-runner": "1.63.2",
    "@voiss/ag-ui-codex-adapter": "workspace:*",
    "@voiss/agent-runtime": "workspace:*",
    "@voiss/demo-fixtures": "workspace:*",
    "@voiss/domain": "workspace:*",
    "@voiss/trust-engine": "workspace:*",
    "better-sqlite3": "12.8.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "7.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
